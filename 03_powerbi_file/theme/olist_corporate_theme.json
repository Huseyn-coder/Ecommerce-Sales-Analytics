{
  "name": "Olist Corporate",
  "dataColors": ["#1F4E79", "#2E75B6", "#8FAADC", "#C9C9C9", "#7F7F7F", "#404040", "#548235", "#BF8F00"],
  "background": "#FFFFFF",
  "foreground": "#333333",
  "tableAccent": "#1F4E79",
  "good": "#548235",
  "neutral": "#BF8F00",
  "bad": "#C00000",
  "textClasses": {
    "title": { "fontSize": 14, "fontFace": "Segoe UI Semibold", "color": "#1F4E79" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#333333" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#333333" },
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#1F4E79" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E6E6E6" } }, "radius": 6 }],
        "visualHeader": [{ "show": false }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F4E79" } }, "fontSize": 12, "alignment": "left" }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F5F6F8" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F5F6F8" } }, "transparency": 0 }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#1F4E79" } }, "fontSize": 24 }],
        "categoryLabels": [{ "color": { "solid": { "color": "#7F7F7F" } }, "fontSize": 10 }]
      }
    }
  }
}
